# Article -> Image pipeline settings (agents/imagegen). Copy to .env or export the variables. Every IMG_* value is optional:
# environment > config.json "image_pipeline" > the default shown here. Never commit real keys: in GitHub they live in Actions secrets.

# --- secrets (environment / GitHub Actions secrets only) ---
CF_ACCOUNT_ID=            # Cloudflare account id (image model, and the default LLM and vision model)
CF_API_TOKEN=             # Cloudflare API token with Workers AI permission
ANTHROPIC_API_KEY=        # optional: only for IMG_LLM_PROVIDER=anthropic
WP_URL=                   # https://your-site.example   (only for --post-id / --batch)
WP_USER=
WP_APP_PASSWORD=          # WordPress application password

# --- behaviour ---
IMG_ENABLED=true                                        # false = use only the writer's one-line image_prompt (the old behaviour)
IMG_LLM_PROVIDER=cloudflare                             # cloudflare | anthropic | none (none = rule-based analysis and template prompts)
IMG_LLM_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast   # cheap, fits the free neurons; @cf/meta/llama-3.3-70b-instruct-fp8-fast is better but ~6x the cost
IMG_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct # needs a one-time licence acceptance: scripts/generate-image --accept-vision-license
IMG_VISION_CHECK=true                                   # quality check by a vision model; skipped automatically when unavailable
IMG_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
IMG_STEPS=4                                             # schnell: 4 at most
IMG_WIDTH=1536                                          # generation size, 16:9, multiples of 32; schnell gets worse above ~1.3 MP
IMG_HEIGHT=864
IMG_SEND_SIZE=true                                      # ask the API for width x height; retried without when rejected (Cloudflare's schnell may ignore it), then upscaled and cropped
IMG_UPSCALER=lanczos                                    # lanczos (built in) | realesrgan (needs the realesrgan-ncnn-vulkan program on the machine) | none
IMG_UPSCALE_FACTOR=2
IMG_UPSCALE_CMD=realesrgan-ncnn-vulkan -i {input} -o {output} -s {scale}   # used only when IMG_UPSCALER=realesrgan; falls back to lanczos if it fails
IMG_OUT_WIDTH=1600                                      # final featured image; use 1920 x 1080 for the large size
IMG_OUT_HEIGHT=900
IMG_OUT_FORMAT=webp                                     # webp | jpeg
IMG_OUT_QUALITY=90                                      # starting quality, lowered in steps until the file fits IMG_MAX_KB
IMG_MIN_QUALITY=78                                      # never lower than this to save bytes
IMG_MAX_KB=400                                          # file size target for page speed ("where possible"; the quality floor wins)
IMG_SHARPEN=0.4                                         # finishing pass: gentle sharpening, 0 = off
IMG_GRAIN=0.015                                         # finishing pass: tiny film grain, 0 = off
IMG_FACE_RESTORE=off                                    # off | command (runs IMG_FACE_RESTORE_CMD on accepted images; keep the strength LOW so skin stays natural)
IMG_FACE_RESTORE_CMD=                                   # e.g. a CodeFormer / GFPGAN wrapper using {input} {output}
IMG_CAST_FILE=agents/imagegen/cast.json                 # the fictional stand-in characters
IMG_SEED=                                               # empty = random per attempt; the seed used is saved in the meta file
IMG_MAX_RETRIES=2                                       # new seed after a failed quality check (3 attempts), then one symbolic-scene fallback
IMG_MIN_SCORE=4                                         # the vision check scores 1-5 on six points; any score under this rejects the image
IMG_PRESET=candid_news_photo                            # candid_news_photo | glossy_magazine | cinematic_still | soft_illustration
IMG_DAILY_IMAGE_CAP=40                                  # image attempts per UTC day across all runs; protects the 10,000 free neurons a day (about 170 neurons per image)
IMG_HISTORY_SIZE=20                                     # recent prompts remembered to vary shot, angle and palette
IMG_CAPTION=                                            # visible caption under the image: EMPTY = none (default). Put text here to switch it on. The AI flag is always kept in the per-article log
IMG_REFERENCE_IMAGES=false                              # build a scene_blueprint from the news photo with the vision model; recreated with stand-ins, never copied
IMG_META_DIR=articles/image-meta                        # per-article JSON and _history.json
