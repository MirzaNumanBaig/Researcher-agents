# Article -> Image pipeline settings (agents/imagegen). Copy to .env or export the variables. Every IMG_* value is optional:
# environment > config.json "image_pipeline" > the default shown here. Never commit real keys: in GitHub they live in Actions secrets.

# --- secrets (environment / GitHub Actions secrets only) ---
CF_ACCOUNT_ID=            # Cloudflare account id (image model, and the default LLM and vision model)
CF_API_TOKEN=             # Cloudflare API token with Workers AI permission
ANTHROPIC_API_KEY=        # optional: only for IMG_LLM_PROVIDER=anthropic
WP_URL=                   # https://your-site.example   (only for --post-id / --batch)
WP_USER=
WP_APP_PASSWORD=          # WordPress application password

# --- behaviour ---
IMG_ENABLED=true                                        # false = use only the writer's one-line image_prompt (the old behaviour)
IMG_LLM_PROVIDER=cloudflare                             # cloudflare | anthropic | none (none = rule-based analysis and template prompts)
IMG_LLM_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast   # cheap, fits the free neurons; @cf/meta/llama-3.3-70b-instruct-fp8-fast is better but ~6x the cost
IMG_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct # needs a one-time licence acceptance: scripts/generate-image --accept-vision-license
IMG_VISION_CHECK=true                                   # quality check by a vision model; skipped automatically when unavailable
IMG_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
IMG_STEPS=4                                             # schnell: 4 at most
IMG_WIDTH=1344
IMG_HEIGHT=768
IMG_SEND_SIZE=true                                      # ask the API for width x height; retried without when rejected, then cropped to size
IMG_SEED=                                               # empty = random per attempt; the seed used is saved in the meta file
IMG_MAX_RETRIES=2                                       # new seed after a failed quality check
IMG_PRESET=candid_news_photo                            # candid_news_photo | glossy_magazine | cinematic_still | soft_illustration
IMG_DAILY_IMAGE_CAP=40                                  # image attempts per UTC day across all runs; protects the 10,000 free neurons a day (about 170 neurons per image)
IMG_HISTORY_SIZE=20                                     # recent prompts remembered to vary shot, angle and palette
IMG_CAPTION=Illustration generated with AI              # off (or empty) turns the caption off
IMG_REFERENCE_IMAGES=false                              # analyse the news photo's composition (needs the vision model); never copied
IMG_META_DIR=articles/image-meta                        # per-article JSON and _history.json
